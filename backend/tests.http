@baseUrl = http://127.0.0.1:8000/api
@userAAccessToken = replace-with-user-a-access-token
@userARefreshToken = replace-with-user-a-refresh-token
@userBAccessToken = replace-with-user-b-access-token
@userANoteId = replace-with-user-a-note-id

### Health check
GET {{baseUrl}}/health/

### Register User A
POST {{baseUrl}}/auth/register/
Content-Type: application/json

{
  "display_name": "User A",
  "email": "user-a@example.com",
  "password": "SecurePassword123"
}

### Register User B
POST {{baseUrl}}/auth/register/
Content-Type: application/json

{
  "display_name": "User B",
  "email": "user-b@example.com",
  "password": "SecurePassword123"
}

### User A creates a note
POST {{baseUrl}}/notes/
Authorization: Bearer {{userAAccessToken}}
Content-Type: application/json

{
  "title": "User A private note",
  "content": "Only User A should access this.",
  "tag": "Testing"
}

### User B lists notes: User A's note must not appear
GET {{baseUrl}}/notes/
Authorization: Bearer {{userBAccessToken}}

### User B reads User A's note: expect 404
GET {{baseUrl}}/notes/{{userANoteId}}/
Authorization: Bearer {{userBAccessToken}}

### User B creates a card in User A's note: expect 403
POST {{baseUrl}}/flashcards/
Authorization: Bearer {{userBAccessToken}}
Content-Type: application/json

{
  "connected_note": {{userANoteId}},
  "question": "Should this work?",
  "answer": "No."
}

### User A completes a review
POST {{baseUrl}}/review/complete/
Authorization: Bearer {{userAAccessToken}}
Content-Type: application/json

{
  "score": 2,
  "total_questions": 3,
  "xp_earned": 75
}

### User B completes a review
POST {{baseUrl}}/review/complete/
Authorization: Bearer {{userBAccessToken}}
Content-Type: application/json

{
  "score": 1,
  "total_questions": 2,
  "xp_earned": 25
}

### User A progress
GET {{baseUrl}}/progress/
Authorization: Bearer {{userAAccessToken}}

### User B progress
GET {{baseUrl}}/progress/
Authorization: Bearer {{userBAccessToken}}

### User A logs out
POST {{baseUrl}}/auth/logout/
Authorization: Bearer {{userAAccessToken}}
Content-Type: application/json

{
  "refresh": "{{userARefreshToken}}"
}
